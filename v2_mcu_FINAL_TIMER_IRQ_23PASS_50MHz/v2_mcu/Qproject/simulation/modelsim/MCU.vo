	.q(\cpu_top_inst|uart_inst|tx~q ),
	.prn(vcc));
// synopsys translate_off
defparam \cpu_top_inst|uart_inst|tx .is_wysiwyg = "true";
defparam \cpu_top_inst|uart_inst|tx .power_up = "low";
// synopsys translate_on

assign led_run = \led_run~output_o ;

assign led_done = \led_done~output_o ;

assign uart_tx_pin = \uart_tx_pin~output_o ;

endmodule
