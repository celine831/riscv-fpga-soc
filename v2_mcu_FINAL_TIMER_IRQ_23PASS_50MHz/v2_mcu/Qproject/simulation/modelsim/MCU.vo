`timescale 1 ps/ 1 ps

module fpga_top (
	sys_clk,
	sys_rst_n,
	led_run,
	led_done,
	uart_tx_pin,
	uart_rx_pin);
input 	sys_clk;
input 	sys_rst_n;
output 	led_run;
output 	led_done;
output 	uart_tx_pin;
input 	uart_rx_pin;

// Design Ports Information
// led_run	=>  Location: PIN_L7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// led_done	=>  Location: PIN_M6,	 I/O Standard: 2.5 V,	 Current Strength: Default
// uart_tx_pin	=>  Location: PIN_N5,	 I/O Standard: 2.5 V,	 Current Strength: Default
// sys_clk	=>  Location: PIN_E1,	 I/O Standard: 2.5 V,	 Current Strength: Default
// sys_rst_n	=>  Location: PIN_M15,	 I/O Standard: 2.5 V,	 Current Strength: Default
// uart_rx_pin	=>  Location: PIN_N6,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
// synopsys translate_off
