set_global_assignment -name EDA_TEST_BENCH_RUN_SIM_FOR "100 us" -section_id tb_imm_gen
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_imm_gen -section_id tb_imm_gen
set_global_assignment -name EDA_TEST_BENCH_NAME tb_instr_rom -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_instr_rom
set_global_assignment -name EDA_TEST_BENCH_RUN_SIM_FOR "100 us" -section_id tb_instr_rom
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_instr_rom -section_id tb_instr_rom
