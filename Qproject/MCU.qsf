set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_location_assignment PIN_M6 -to led_done
set_location_assignment PIN_L7 -to led_run
set_location_assignment PIN_M15 -to sys_rst_n
set_location_assignment PIN_E1 -to sys_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_done
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_run
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sys_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sys_rst_n
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top