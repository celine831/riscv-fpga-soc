`timescale 1 ps/ 1 ps

module fpga_top (
	sys_clk,
	sys_rst_n,
	led_run,
	led_done);
input 	sys_clk;
input 	sys_rst_n;
output 	led_run;
output 	led_done;

// Design Ports Information
// led_run	=>  Location: PIN_L7,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 8mA
// led_done	=>  Location: PIN_M6,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 8mA
// sys_clk	=>  Location: PIN_E1,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: Default
// sys_rst_n	=>  Location: PIN_M15,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: Default


